{
  "manifest_version": 3,
  "name": "Lottie Previewer",
  "version": "1.0.0",
  "description": "Preview Lottie JSON animations instantly - by Zone 99",
  "author": "Zone 99",
  "homepage_url": "https://99.zone",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lottie Previewer"
  },
  "permissions": ["storage", "tabs"],
  "web_accessible_resources": [
    {
      "resources": ["libs/gif.worker.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
